# CSV to Parquet Converter API Configuration

# Environment
ENVIRONMENT=development
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Database Configuration (SQLite for development)
DATABASE_PATH=metadata.db

# PostgreSQL Configuration (for production - Neon example)
POSTGRES_HOST=xxxxxxxxxxxxxxxxxxxx
POSTGRES_PORT=xxxxxxxxxxxxxxx
POSTGRES_DB=neondb
POSTGRES_USER=xxxxxxxxxxxxxxx
POSTGRES_PASSWORD=xxxxxxx

# Or use the full DATABASE_URL (recommended for Neon)
DATABASE_URL=postgresql://neondb_owner:npg_IO2PHryK6lBo@ep-nameless-art-aeo7798p-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require

# R2 Cloud Storage Configuration  
USE_CLOUD_STORAGE=false
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=csv-converter-storage
R2_REGION=auto

# File Storage Configuration
UPLOAD_DIR=uploads
PARQUET_DIR=parquet
MAX_FILE_SIZE=104857600  # 100MB in bytes

# Authentication Configuration
JWT_SECRET_KEY=your-super-secure-secret-key-here-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Processing Configuration
PROCESSING_DELAY_SECONDS=3

# CORS Configuration (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Production CORS (use this for production)
# CORS_ORIGINS=https://your-frontend-domain.com,https://api.your-domain.com 